#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<vector<int>> ans;
    
    bool isSafe(vector<int>& board, int row, int col, int n) {
        for (int i = 0; i < row; i++) {
            if (board[i] == col || abs(board[i] - col) == abs(i - row))
                return false;
        }
        return true;
    }

    void solve(int row, vector<int>& board, int n) {
        if (row == n) {
            vector<int> config = board;
            for (int& x : config) x++; 
            ans.push_back(config);
            return;
        }
        for (int col = 0; col < n; col++) {
            if (isSafe(board, row, col, n)) {
                board[row] = col;
                solve(row + 1, board, n);
                board[row] = -1;
            }
        }
    }

    vector<vector<int>> nQueen(int n) {
        vector<int> board(n, -1);
        solve(0, board, n);
        return ans;
    }
};
