class Solution {
    void findCombination(int ind, int target, vector<int>& arr, vector<vector<int>>& ans, vector<int>& ds) {
        // Base case: if target == 0, we found a valid combination
        if (target == 0) {
            ans.push_back(ds);
            return;
        }

        // If we reach end of array, stop recursion
        if (ind == arr.size()) return;

        // Pick the current element if it does not exceed target
        if (arr[ind] <= target) {
            ds.push_back(arr[ind]);  // take it
            findCombination(ind, target - arr[ind], arr, ans, ds); // same index since we can reuse element
            ds.pop_back(); // backtrack
        }

        // Not pick the element and move to next index
        findCombination(ind + 1, target, arr, ans, ds);
    }

public:
    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        vector<vector<int>> ans;
        vector<int> ds;
        findCombination(0, target, candidates, ans, ds);
        return ans;
    }
};
